{
  "name": "@local/dsh-jimeng-seedance",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Connect the signed-in Jimeng (即梦 AI) desktop app to DeepSeek Harness: image and video generation, with the model catalog read live from the account.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "jimeng",
    "即梦",
    "dreamina",
    "seedream",
    "seedance",
    "text-to-image",
    "text-to-video",
    "image-generation",
    "video-generation",
    "ai-image",
    "ai-video"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "license": "MIT",
  "author": {
    "name": "MokoKing666"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MokoKing666/dsh-jimeng.git"
  },
  "homepage": "https://github.com/MokoKing666/dsh-jimeng#readme",
  "bugs": {
    "url": "https://github.com/MokoKing666/dsh-jimeng/issues"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
